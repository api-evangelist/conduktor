    "_postman_id": "fd050d50-60cd-457d-87a1-addda90cd652",
    "name": "Conduktor Certificates Self-Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Unified specification of the Conduktor REST API surface, covering the Conduktor Console API (clusters, certificates, users, groups, RBAC permissions, and declarative Self-Service resources) and the Conduktor Gateway API (interceptors, virtual clusters, service accounts, and tokens). Console endpoints authenticate with an admin-generated Bearer API key; Gateway admin endpoints authenticate with Basic auth. Host names are deployment-specific.\n\nContact Support:\n Name: Conduktor Support",
      "type": "text/plain"
    }
